NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supermemento
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Text-generation provider: anthropic (default), openai-codex (legacy relay),
# or openai-codex-subscription (official Codex runtime + ChatGPT sign-in).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shared Codex settings.
OPENAI_CODEX_MODEL=gpt-5.6-luna
LLM_REQUEST_TIMEOUT_MS=180000
LLM_REASONING_EFFORT=low

# Required only when LLM_PROVIDER=openai-codex-subscription.
# Mount this exact path from persistent storage and authenticate it with `codex login`.
CODEX_HOME=/data/supermemento-codex
OPENAI_CODEX_WORKDIR=/app

# Required only when LLM_PROVIDER=openai-codex. This is the legacy Hermes relay rollback.
OPENAI_CODEX_BASE_URL=
# Prefer a Docker secret file. OPENAI_CODEX_RELAY_KEY remains available for local development.
OPENAI_CODEX_RELAY_KEY_FILE=/run/secrets/supermemento_codex_relay_key

# ChatGPT MCP gateway (separate auth service; reuses Supermemento over the internal network).
PUBLIC_BASE_URL=https://n8n-supermemento-chatgpt.9kpuqs.easypanel.host
UPSTREAM_MCP_URL=http://n8n_supermemento:80/mcp
UPSTREAM_ALLOWED_HOSTS=n8n_supermemento,n8n-supermemento,supermemento
ALLOWED_CLIENT_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Store only the SHA-256 digest. Keep the raw owner/setup token outside the container.
MCP_GATEWAY_OWNER_TOKEN_SHA256_FILE=/run/secrets/supermemento_chatgpt_owner_token_sha256
MCP_GATEWAY_OAUTH_STORE_PATH=/data/oauth-store.json
PORT=8080
